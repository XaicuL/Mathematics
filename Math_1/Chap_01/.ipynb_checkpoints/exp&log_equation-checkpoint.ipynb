    "# **지수&로그 방정식**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b5e041315bb7f2b4",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sympy as sp\n",
    "sp.init_printing()\n",
    "\n",
    "x = sp.symbols('x')\n",
    "y = sp.symbols('y')\n",
    "\n",
    "exp1 = 2**x\n",
    "exp2 = 3**y\n",
    "\n",
    "sol1 = sp.solve(sp.Eq(exp1, exp2), x)\n"
   ]
  },
