   "source": "# 근과 계수와의 관계",
   "id": "3d5c575da618ad6c"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-03-17T14:29:07.498177Z",
     "start_time": "2026-03-17T14:29:07.477353Z"
    }
   },
   "cell_type": "code",
   "source": [
    "from sympy import symbols, Poly\n",
    "\n",
    "x = symbols('x')\n",
    "ex = x**2 - 5*x + 6\n",
    "\n",
    "p = Poly(ex, x)\n",
    "\n",
    "coeffs = p.all_coeffs()\n",
    "a, b, c = coeffs\n",
    "\n",
    "sum_roots = -b / a\n",
    "prod_roots = c / a\n",
    "\n",
    "print(f\"합: {sum_roots}, 곱: {prod_roots}\")\n"
   ],
   "id": "eb6fd411ab31ba93",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "합: 5, 곱: 6\n"
     ]
    }
   ],
   "execution_count": 3
  },
